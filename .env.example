# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Dev Panel + QA tools
NEXT_PUBLIC_DEBUG_MODE=false


# LOCAL SETUP
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=


# Supabase project URL and public anon key (Project Settings > API).
# Used for browser/session auth (@supabase/ssr).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service-role key (Project Settings > API). Server-only, bypasses
# RLS — never expose this to the client. Used by createServiceClient() in
# API routes for all database reads/writes.
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio API key (https://aistudio.google.com/apikey).
# Used for two things:
#  - Gemini (gemini-2.5-flash) sentence/interview feedback and AI-generated
#    practice content.
#  - Google Cloud Text-to-Speech (src/app/api/tts/route.ts), which reuses
#    this same key.
GEMINI_API_KEY=

ELEVENLABS_API_KEY=

