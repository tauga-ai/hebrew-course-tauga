# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Dev Panel + QA tools
NEXT_PUBLIC_DEBUG_MODE=false


# LOCAL SETUP
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=


# Supabase project URL and public anon key (Project Settings > API).
# Used for browser/session auth (@supabase/ssr).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service-role key (Project Settings > API). Server-only, bypasses
# RLS — never expose this to the client. Used by createServiceClient() in
# API routes for all database reads/writes.
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio API key (https://aistudio.google.com/apikey).
# Used for two things:
#  - Gemini (gemini-2.5-flash) sentence/interview feedback and AI-generated
#    practice content.
#  - Google Cloud Text-to-Speech (src/app/api/tts/route.ts), which reuses
#    this same key.
GEMINI_API_KEY=

# Google Cloud Translation API key (https://console.cloud.google.com/apis/credentials).
# Used only for Naale's click-to-translate (Hebrew -> Russian, single words).
# Separate from GEMINI_API_KEY — a different Google product, its own key.
GOOGLE_TRANSLATE_API=

ELEVENLABS_API_KEY=


# Who to notify when a student reports a mistake in a question (Naale, N4).
# Comma-separated. Optional: reports are always written to
# naale_question_reports and shown on /naale/staff/reports regardless, so an
# unset value costs a notification, never a report.
NAALE_REPORT_NOTIFY_EMAILS=

# Sends the above via Gmail SMTP (question-reports-notify.ts). GMAIL_USER is
# the sending account's address; GMAIL_APP_PASSWORD is a 16-character App
# Password (Google Account > Security > 2-Step Verification > App passwords)
# for that account, NOT its real password. Either unset falls back to
# logging the intended recipients instead of sending.
GMAIL_USER=
GMAIL_APP_PASSWORD=
